# NeuroTRIBE-HBN â€” copy to .env and adjust. Never commit the real .env.

# ---------------------------------------------------------------- profile
# development : mock TRIBE fallback allowed, approximate surfaces allowed.
# production  : real TRIBE required, no approximations permitted.
NEUROTRIBE_PROFILE=development

# ---------------------------------------------------------------- database
POSTGRES_USER=neurotribe
POSTGRES_PASSWORD=change-me-before-any-shared-deployment
POSTGRES_DB=neurotribe
POSTGRES_PORT=5432

# ---------------------------------------------------------------- ports
API_PORT=8000
WEB_PORT=4321
REDIS_PORT=6379

# ---------------------------------------------------------------- frontend
# Origin the BROWSER uses to reach the API.
PUBLIC_API_BASE=http://localhost:8000/api

# ---------------------------------------------------------------- workers
# Keep this low: fMRIPrep is memory-hungry and runs one participant at a time.
WORKER_CONCURRENCY=2

# ---------------------------------------------------------------- build
# base | dev  (dev enables --reload and installs the test toolchain)
BUILD_TARGET=base
# runtime | dev
WEB_TARGET=runtime

# ---------------------------------------------------------------- TRIBE v2
# Installed into the API/worker image during `docker compose build`.
# The one-shot tribe-bootstrap service downloads its pretrained weights into
# the persistent `model-cache` volume before the API and worker start.
TRIBE_REPO=https://github.com/facebookresearch/tribev2
TRIBE_GIT_REF=main
# CPU wheels work everywhere. For an NVIDIA-enabled Compose deployment, point
# this at the matching CUDA PyTorch wheel index and expose the GPU to Docker.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
TORCH_VERSION=2.5.1+cpu
TORCHVISION_VERSION=0.20.1+cpu

# Optional protected Hugging Face GPU endpoint for real visual TRIBE inference.
# The local API sends only the generated stimulus video; local fMRI never leaves
# this machine. See deploy/hf-tribe-endpoint/README.md before setting these.
# NEUROTRIBE__TRIBE__HOSTED__ENDPOINT_URL=https://YOUR-ENDPOINT.endpoints.huggingface.cloud
# NEUROTRIBE__TRIBE__HOSTED__PROTOCOL=hf-space
# HF_TRIBE_ENDPOINT_TOKEN=hf_your_token

# ---------------------------------------------------------------- FreeSurfer
# Required for research-grade surface preprocessing. Obtain a free license at
# https://surfer.nmr.mgh.harvard.edu/registration.html and place it at
# config/license.txt, or point FS_LICENSE at it.
# FS_LICENSE=/app/config/license.txt

# ---------------------------------------------------------------- overrides
# Any scientific parameter can be overridden as NEUROTRIBE__<SECTION>__<KEY>.
# These participate in analysis_config_hash, so a changed value invalidates the
# cache and is recorded in every provenance manifest.
# NEUROTRIBE__QC__MOTION__FD_THRESHOLD_MM=0.5
# NEUROTRIBE__COHORT__MIN_GROUP_SIZE=10
# NEUROTRIBE__TRIBE__BACKEND=real
# NEUROTRIBE__TRIBE__DEVICE=cuda
# NEUROTRIBE__PREPROCESSING__FMRIPREP__MEM_MB=8000

# ---------------------------------------------------------------- privacy
# Scientific data must never leave this machine.
HF_HUB_DISABLE_TELEMETRY=1
WANDB_DISABLED=true
