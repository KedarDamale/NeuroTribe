---
import Base from '../layouts/Base.astro';
import { safeGet, fmt } from '../lib/api';

const cohort = await safeGet<any>('/cohort?tier=PRIMARY', { available: false });
const exploratory = await safeGet<any>('/cohort?tier=EXPLORATORY', { available: false });

const GROUP_ACCENT: Record<string, string> = {
  CONFIRMED_ADHD: 'var(--color-plasma)',
  NO_DIAGNOSIS_GIVEN: 'var(--color-vital)',
  NON_ADHD_COMPARISON: 'var(--color-cyan)',
  EXCLUDED_UNCERTAIN: 'var(--fg-faint)',
};

/** Render a simple horizontal distribution bar chart from a count map. */
function bars(counts: Record<string, number>): { label: string; n: number; pct: number }[] {
  const entries = Object.entries(counts ?? {});
  const max = Math.max(1, ...entries.map(([, n]) => n));
  return entries.map(([label, n]) => ({ label, n, pct: n / max }));
}
---

<Base
  title="Cohort"
  subtitle={cohort.available ? `${cohort.name} · hash ${cohort.cohort_hash?.slice(0, 12)}` : 'Not built yet'}
  active="cohort"
>
  {!cohort.available ? (
    <div class="panel grid place-items-center px-6 py-16 text-center">
      <div class="max-w-md">
        <p class="text-sm font-medium">No cohort has been built yet</p>
        <p class="mt-1.5 text-[0.8rem]" style="color: var(--fg-muted)">
          {cohort.reason ?? 'Cohort construction requires DUA-approved phenotype data. No ADHD label is ever invented while that is pending.'}
        </p>
      </div>
    </div>
  ) : (
    <div class="space-y-7">
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {cohort.groups.map((group: any) => (
          <div class="panel relative overflow-hidden p-4">
            <div
              class="absolute inset-x-0 top-0 h-0.5"
              style={`background: ${GROUP_ACCENT[group.key] ?? 'var(--fg-faint)'}`}
            />
            <div class="text-[0.66rem] font-semibold uppercase tracking-[0.09em]" style="color: var(--fg-faint)">
              {group.label}
            </div>
            <div class="mt-1.5 text-3xl font-semibold numeric">{group.n}</div>
          </div>
        ))}
      </div>

      {cohort.warnings?.length > 0 && (
        <ul class="panel space-y-1.5 p-4 text-[0.79rem]" style="color: var(--color-ember)">
          {cohort.warnings.map((warning: string) => <li>⚠ {warning}</li>)}
        </ul>
      )}

      <section>
        <h2 class="mb-1 text-[1.05rem] font-semibold tracking-tight">Covariate balance</h2>
        <p class="mb-3 max-w-2xl text-[0.79rem]" style="color: var(--fg-muted)">
          Standardized mean differences above 0.25 mean the covariate-adjusted
          model is doing real work — read the group results with that in mind.
        </p>
        <div class="panel overflow-x-auto">
          <table class="w-full min-w-[38rem] border-collapse text-left">
            <thead>
              <tr>
                {['Variable', 'ADHD mean', 'Comparison mean', 'SMD', 'n ADHD', 'n comparison'].map((column) => (
                  <th
                    class="border-b px-3 py-2.5 text-[0.64rem] font-semibold uppercase tracking-[0.07em]"
                    style="color: var(--fg-faint)"
                  >
                    {column}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {cohort.diagnostics?.continuous?.map((row: any) => (
                <tr>
                  <td class="border-b px-3 py-2 text-[0.82rem]">{row.variable}</td>
                  <td class="border-b px-3 py-2 text-[0.82rem] numeric">{fmt.num(row.case_mean)}</td>
                  <td class="border-b px-3 py-2 text-[0.82rem] numeric">{fmt.num(row.control_mean)}</td>
                  <td
                    class="border-b px-3 py-2 text-[0.82rem] numeric font-semibold"
                    style={Math.abs(row.std_mean_difference ?? 0) > 0.25 ? 'color: var(--color-ember)' : ''}
                  >
                    {fmt.num(row.std_mean_difference, 2)}
                  </td>
                  <td class="border-b px-3 py-2 text-[0.82rem] numeric" style="color: var(--fg-muted)">{row.n_case}</td>
                  <td class="border-b px-3 py-2 text-[0.82rem] numeric" style="color: var(--fg-muted)">{row.n_control}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section>
        <h2 class="mb-3 text-[1.05rem] font-semibold tracking-tight">Distributions</h2>
        <div class="grid gap-3 md:grid-cols-2">
          {['age', 'mean_fd'].map((variable) => (
            <div class="panel p-4">
              <div class="mb-2.5 text-[0.66rem] font-semibold uppercase tracking-[0.09em]" style="color: var(--fg-faint)">
                {variable === 'age' ? 'Age (years)' : 'Mean framewise displacement (mm)'}
              </div>
              <div class="space-y-2.5">
                {Object.entries(cohort.distributions?.[variable] ?? {}).map(([group, counts]: any) => (
                  <div>
                    <div class="mb-1 text-[0.68rem]" style={`color: ${GROUP_ACCENT[group] ?? 'var(--fg-muted)'}`}>
                      {group.replaceAll('_', ' ').toLowerCase()}
                    </div>
                    <div class="flex items-end gap-0.5" style="height: 46px">
                      {bars(counts).map((bar) => (
                        <div
                          class="flex-1 rounded-t-sm"
                          title={`${bar.label}: ${bar.n}`}
                          style={`height: ${Math.max(4, bar.pct * 100)}%; background: ${GROUP_ACCENT[group] ?? 'var(--fg-faint)'}; opacity: 0.75`}
                        />
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="mb-1 text-[1.05rem] font-semibold tracking-tight">Exclusions</h2>
        <p class="mb-3 text-[0.79rem]" style="color: var(--fg-muted)">
          Every excluded participant carries a machine-readable reason — nothing is dropped silently.
        </p>
        <div class="panel divide-y">
          {Object.entries(cohort.exclusion_breakdown ?? {}).map(([reason, count]: any) => (
            <div class="flex items-center justify-between px-4 py-2.5">
              <span class="text-[0.82rem]">{reason.replaceAll('_', ' ').toLowerCase()}</span>
              <span class="text-[0.82rem] font-semibold numeric">{count}</span>
            </div>
          ))}
          {Object.keys(cohort.exclusion_breakdown ?? {}).length === 0 && (
            <div class="px-4 py-3 text-[0.8rem]" style="color: var(--fg-muted)">No exclusions.</div>
          )}
        </div>
      </section>

      {exploratory.available && (
        <section class="panel p-4">
          <h2 class="text-[0.95rem] font-semibold tracking-tight">Exploratory comparison cohort</h2>
          <p class="mt-1 text-[0.79rem]" style="color: var(--fg-muted)">
            {exploratory.n_control} participants form the
            <strong> non-ADHD comparison cohort</strong>. It may include people with
            other diagnoses and is therefore never described as “healthy controls”.
          </p>
        </section>
      )}

      <p class="text-[0.74rem]" style="color: var(--fg-faint)">{cohort.note}</p>
    </div>
  )}
</Base>
