---
import Base from '../layouts/Base.astro';
import { safeGet, fmt } from '../lib/api';

const reports = await safeGet<any>('/reports', { artifacts: [], count: 0 });
const provenance = await safeGet<any>('/reports/provenance?tier=PRIMARY', {
  provenance: {}, limitations: [], generated_at: null,
});

const KIND_LABEL: Record<string, string> = {
  report_html: 'HTML report',
  report_pdf: 'PDF report',
  roi_csv: 'ROI results (CSV)',
  network_csv: 'Network results (CSV)',
  provenance: 'Provenance manifest (JSON)',
};
---

<Base
  title="Reports"
  subtitle="Research report, result tables and the reproducibility manifest"
  active="reports"
>
  <div class="space-y-7">
    <section>
      <div class="mb-3 flex flex-wrap items-end justify-between gap-2">
        <div>
          <h2 class="text-[1.05rem] font-semibold tracking-tight">Artefacts</h2>
          <p class="text-[0.79rem]" style="color: var(--fg-muted)">
            Every artefact is hashed and carries the manifest that produced it.
          </p>
        </div>
        <form method="post" action="/api/reports/generate">
          <button
            type="submit"
            class="rounded-lg px-3 py-1.5 text-[0.78rem] font-semibold"
            style="background: var(--color-signal); color: white"
          >
            Generate now
          </button>
        </form>
      </div>

      {reports.artifacts.length === 0 ? (
        <div class="panel grid place-items-center px-6 py-14 text-center">
          <div class="max-w-md">
            <p class="text-sm font-medium">No reports generated yet</p>
            <p class="mt-1.5 text-[0.8rem]" style="color: var(--fg-muted)">
              A report is produced automatically once a group analysis completes.
            </p>
          </div>
        </div>
      ) : (
        <div class="panel divide-y">
          {reports.artifacts.map((artifact: any) => (
            <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <span class="text-[0.86rem] font-medium">
                    {KIND_LABEL[artifact.kind] ?? artifact.kind}
                  </span>
                  {artifact.tier && (
                    <span
                      class="rounded px-1.5 py-px text-[0.6rem] font-bold tracking-wide"
                      style={`background: color-mix(in oklab, ${artifact.tier === 'PRIMARY' ? 'var(--color-signal)' : 'var(--color-plasma)'} 18%, transparent); color: ${artifact.tier === 'PRIMARY' ? 'var(--color-signal)' : 'var(--color-plasma)'}`}
                    >
                      {artifact.tier}
                    </span>
                  )}
                </div>
                <div class="mt-0.5 text-[0.7rem] numeric" style="color: var(--fg-faint)">
                  {fmt.bytes(artifact.size_bytes)} · sha256 {artifact.sha256?.slice(0, 16)}…
                </div>
              </div>
              <a
                href={artifact.download_url}
                class="shrink-0 rounded-lg px-3 py-1.5 text-[0.76rem] font-semibold"
                style="background: var(--glass); color: var(--color-signal)"
              >
                Download
              </a>
            </div>
          ))}
        </div>
      )}
    </section>

    <section>
      <h2 class="mb-1 text-[1.05rem] font-semibold tracking-tight">Reproducibility manifest</h2>
      <p class="mb-3 text-[0.79rem]" style="color: var(--fg-muted)">
        Mandatory for every result. It pins the TRIBE commit and model revision,
        the fMRIPrep version, the stimulus hash, the cohort hash and the exact
        scientific configuration.
      </p>
      <pre
        class="panel max-h-96 overflow-auto p-4 text-[0.7rem] numeric"
      >{JSON.stringify(provenance.provenance, null, 2)}</pre>
    </section>

    <section>
      <h2 class="mb-3 text-[1.05rem] font-semibold tracking-tight">Limitations</h2>
      <ul class="panel space-y-2 p-4 text-[0.8rem] leading-relaxed" style="color: var(--fg-muted)">
        {provenance.limitations?.map((item: string) => <li>• {item}</li>)}
      </ul>
    </section>
  </div>
</Base>
