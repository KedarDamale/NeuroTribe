---
import '../styles/global.css';
import ThemeToggle from '../components/react/ThemeToggle.tsx';

interface Props {
  title: string;
  subtitle?: string;
  active?: string;
}

const { title, subtitle, active = '' } = Astro.props;

const NAV = [
  { href: '/', label: 'Dashboard', key: 'dashboard', icon: 'grid' },
  { href: '/data', label: 'Data', key: 'data', icon: 'database' },
  { href: '/cohort', label: 'Cohort', key: 'cohort', icon: 'users' },
  { href: '/subjects', label: 'Subjects', key: 'subjects', icon: 'brain' },
  { href: '/groups', label: 'Group Analysis', key: 'groups', icon: 'chart' },
  { href: '/qc', label: 'Quality Control', key: 'qc', icon: 'shield' },
  { href: '/jobs', label: 'Jobs', key: 'jobs', icon: 'activity' },
  { href: '/reports', label: 'Reports', key: 'reports', icon: 'file' },
];

const ICONS: Record<string, string> = {
  grid: 'M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z',
  database: 'M12 3c4.97 0 9 1.34 9 3s-4.03 3-9 3-9-1.34-9-3 4.03-3 9-3zM3 6v6c0 1.66 4.03 3 9 3s9-1.34 9-3V6M3 12v6c0 1.66 4.03 3 9 3s9-1.34 9-3v-6',
  users: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
  brain: 'M12 4.5a3 3 0 0 0-6 0 3 3 0 0 0-1.5 5.6A3 3 0 0 0 6 16a3 3 0 0 0 6 1.5M12 4.5a3 3 0 0 1 6 0 3 3 0 0 1 1.5 5.6A3 3 0 0 1 18 16a3 3 0 0 1-6 1.5M12 4.5v13',
  chart: 'M3 3v18h18M7 15l3-4 3 3 5-7',
  shield: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10zM9 12l2 2 4-4',
  activity: 'M22 12h-4l-3 9L9 3l-3 9H2',
  file: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M16 13H8M16 17H8',
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Stimulus-conditioned normative cortical response analysis for ADHD using TRIBE v2 and Healthy Brain Network movie-fMRI. Research use only." />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · NeuroTRIBE</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ctext y='26' font-size='26'%3E🧠%3C/text%3E%3C/svg%3E" />
    <script is:inline>
      // Apply the stored theme before first paint to avoid a flash.
      try {
        const stored = localStorage.getItem('nt-theme');
        if (stored) document.documentElement.dataset.theme = stored;
      } catch {}
    </script>
  </head>
  <body>
    <div class="relative z-10 flex min-h-dvh">
      <!-- Sidebar -->
      <aside
        class="sticky top-0 hidden h-dvh w-60 shrink-0 flex-col border-r px-3 py-5 lg:flex"
        style="background: color-mix(in oklab, var(--bg-elevated) 70%, transparent); backdrop-filter: blur(12px);"
      >
        <a href="/" class="mb-7 flex items-center gap-2.5 px-2">
          <div
            class="grid h-9 w-9 place-items-center rounded-xl text-lg"
            style="background: linear-gradient(140deg, var(--color-signal), var(--color-plasma)); box-shadow: var(--shadow-glow);"
          >
            <span aria-hidden="true">🧠</span>
          </div>
          <div class="leading-tight">
            <div class="text-[0.95rem] font-semibold tracking-tight">NeuroTRIBE</div>
            <div class="text-[0.68rem] font-medium tracking-wide" style="color: var(--fg-faint)">
              HBN · TRIBE v2
            </div>
          </div>
        </a>

        <nav class="flex flex-1 flex-col gap-0.5" aria-label="Primary">
          {NAV.map((item) => (
            <a
              href={item.href}
              aria-current={active === item.key ? 'page' : undefined}
              class="group flex items-center gap-3 rounded-lg px-2.5 py-2 text-[0.86rem] font-medium transition-colors"
              style={
                active === item.key
                  ? 'background: color-mix(in oklab, var(--color-signal) 16%, transparent); color: var(--fg);'
                  : 'color: var(--fg-muted);'
              }
            >
              <svg
                width="16" height="16" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="1.9"
                stroke-linecap="round" stroke-linejoin="round"
                class="shrink-0 transition-transform group-hover:scale-110"
                style={active === item.key ? 'color: var(--color-signal)' : ''}
                aria-hidden="true"
              >
                <path d={ICONS[item.icon]} />
              </svg>
              {item.label}
            </a>
          ))}
        </nav>

        <div class="mt-4 space-y-2.5 px-1">
          <ThemeToggle client:load />
          <p class="text-[0.66rem] leading-snug" style="color: var(--fg-faint)">
            Research Use Only — not a diagnostic or medical device.
          </p>
        </div>
      </aside>

      <!-- Main -->
      <div class="flex min-w-0 flex-1 flex-col">
        <header
          class="sticky top-0 z-20 border-b px-5 py-3.5 lg:px-8"
          style="background: color-mix(in oklab, var(--bg) 80%, transparent); backdrop-filter: blur(16px) saturate(160%);"
        >
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="min-w-0">
              <h1 class="truncate text-lg font-semibold tracking-tight lg:text-xl">{title}</h1>
              {subtitle && (
                <p class="mt-0.5 truncate text-[0.8rem]" style="color: var(--fg-muted)">
                  {subtitle}
                </p>
              )}
            </div>
            <span
              class="shrink-0 rounded-full px-2.5 py-1 text-[0.66rem] font-semibold uppercase tracking-[0.08em]"
              style="background: color-mix(in oklab, var(--color-ember) 18%, transparent); color: var(--color-ember); border: 1px solid color-mix(in oklab, var(--color-ember) 35%, transparent);"
            >
              Research use only
            </span>
          </div>

          <!-- Mobile nav -->
          <nav class="mt-3 -mx-1 flex gap-1 overflow-x-auto pb-1 lg:hidden" aria-label="Primary mobile">
            {NAV.map((item) => (
              <a
                href={item.href}
                class="shrink-0 rounded-lg px-3 py-1.5 text-[0.8rem] font-medium"
                style={
                  active === item.key
                    ? 'background: color-mix(in oklab, var(--color-signal) 18%, transparent); color: var(--fg);'
                    : 'color: var(--fg-muted);'
                }
              >
                {item.label}
              </a>
            ))}
          </nav>
        </header>

        <main class="flex-1 px-5 py-6 lg:px-8 lg:py-8">
          <slot />
        </main>

        <footer class="px-5 py-6 text-[0.72rem] lg:px-8" style="color: var(--fg-faint)">
          NeuroTRIBE-HBN · stimulus-conditioned normative cortical response analysis ·
          TRIBE v2 is used as a pretrained reference model and is never retrained here ·
          <strong>Not a diagnostic tool.</strong>
        </footer>
      </div>
    </div>
  </body>
</html>
