---
import '../styles/global.css';
interface Props { title: string; subtitle?: string; }
const { title, subtitle } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="dark">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="Exploratory single-subject TRIBE analysis. Research use only." /><meta name="robots" content="noindex, nofollow" /><title>{title} · NeuroTRIBE</title></head>
<body><div class="relative z-10 min-h-dvh"><header class="sticky top-0 z-20 border-b px-5 py-4 lg:px-8" style="background: color-mix(in oklab, var(--bg) 86%, transparent); backdrop-filter: blur(16px)"><div class="flex flex-wrap items-center justify-between gap-3"><div><h1 class="text-lg font-semibold tracking-tight lg:text-xl">{title}</h1>{subtitle && <p class="mt-0.5 text-[.8rem]" style="color: var(--fg-muted)">{subtitle}</p>}</div><span class="status-pill">Research use only</span></div></header><main class="mx-auto max-w-[1800px] px-5 py-6 lg:px-8 lg:py-8"><slot /></main><footer class="px-5 py-6 text-center text-[.72rem]" style="color: var(--fg-faint)">NeuroTRIBE exploratory viewer · TRIBE v2 is a pretrained reference model · not a diagnostic tool.</footer></div></body></html>
