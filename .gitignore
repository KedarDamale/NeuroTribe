# =============================================================================
# NeuroTRIBE-HBN
#
# NOTHING protected may ever enter version control. HBN phenotype data are
# DUA-controlled, the movie stimulus is copyrighted, and imaging derivatives can
# be re-identifying. All three are hard-excluded below.
# =============================================================================

# --- protected / licensed data (NEVER COMMIT) --------------------------------
data/phenotype/**
!data/phenotype/incoming/README.md
data/stimuli/**
!data/stimuli/incoming/README.md
data/raw/**
data/derivatives/**
data/external/**
data/metadata/**
data/analysis/**
data/tribe/**
data/reports/**
data/logs/**
data/*.db
data/*.db-*

# --- neuroimaging binaries ---------------------------------------------------
*.nii
*.nii.gz
*.gii
*.mgz
*.mgh
*.annot
*.dscalar.nii
*.dtseries.nii
*.func.gii
*.surf.gii

# --- caches and scratch ------------------------------------------------------
cache/**
work/**
!work/.gitkeep

# --- credentials -------------------------------------------------------------
.env
.env.*
!.env.example
license.txt
config/license.txt
secrets/
*.pem
*.key

# --- python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# --- node / astro ------------------------------------------------------------
node_modules/
apps/web/dist/
apps/web/.astro/
.npm/
*.tsbuildinfo

# --- editors / os ------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
